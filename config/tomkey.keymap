#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        LEFT_HRMs: LEFT_HRMs {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HRMS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <34 22 10 0 1 1 2 11 12 23 24 35 36 3 4 13 14 15 25 26 27 37 38 39>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        LAYER_HRM: LAYER_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HRM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 22 23 24 25 26 5 6 7 8 9 17 18 19 20 21 29 30 31 32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E             &kp R           &kp T                                                          &kp Y  &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D             &kp F           &kp G                &kp ESCAPE         &LAYER_HRM 5 COLON     &kp H  &kp J  &kp K      &kp L    &LEFT_HRMs RIGHT_SHIFT SEMICOLON
&kp Z      &kp X         &kp C             &kp V           &kp B                &kp BACKSPACE      &LAYER_HRM 4 LEFT_WIN  &kp N  &kp M  &kp COMMA  &kp DOT  &lt 2 SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &LAYER_HRM 4 ESCAPE  &kp SPACE          &kp ENTER              &sl 3                             &kp TAB
            >;
        };

        MOUSE {
            bindings = <
&trans     &trans        &trans            &trans          &trans                      &trans  &trans    &trans    &trans    &trans
&trans     &trans        &trans            &trans          &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans     &trans        &trans            &trans          &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &trans  &trans      &trans  &to 0                                 &trans
            >;
        };

        SCROLL {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SIMBOL {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH  &kp DOLLAR  &kp PERCENT                       &kp AMPERSAND   &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE
&kp AT_SIGN      &kp BACKSLASH      &kp PIPE  &kp PLUS    &kp ASTERISK  &trans      &trans  &kp MINUS       &kp EQUAL         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE
&trans           &trans             &trans    &trans      &trans        &trans      &trans  &kp UNDERSCORE  &kp CARET         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION
&trans           &trans             &trans    &trans      &trans        &trans      &trans  &trans                                                                         &trans
            >;
        };

        NUM {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4   &kp N5                           &kp NUMBER_6  &kp N7        &kp N8           &kp N9           &kp N0
&trans        &trans        &kp LA(GRAVE)  &kp LC(SPACE)  &kp LC(INS)  &trans      &trans  &kp LEFT      &kp DOWN      &kp UP_ARROW     &kp RIGHT_ARROW  &kp PG_UP
&trans        &trans        &trans         &trans         &kp LS(INS)  &trans      &trans  &kp INS       &kp C_VOL_DN  &kp C_VOLUME_UP  &kp PRINTSCREEN  &kp PAGE_DOWN
&trans        &trans        &trans         &trans         &trans       &trans      &trans  &trans                                                        &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5                            &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans      &trans        &trans        &trans        &trans        &trans      &trans  &kp F11  &kp F12  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans  &trans   &trans   &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans      &trans  &trans                            &trans
            >;
        };
    };
};
